{
  "manifest_version": 3,
  "name": "VISA AUTOMATOR",
  "version": "1.0.0",
  "description": "Professional human-in-the-loop browser automation assistant for IVAC visa appointment scheduling.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://appointment.ivacbd.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://appointment.ivacbd.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "VISA AUTOMATOR"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
